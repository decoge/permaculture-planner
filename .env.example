# Postgres connection string used by the server
DATABASE_URL=postgres://planner:planner@localhost:5432/permaculture

# Secret used to sign session cookies. Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-string

# Optional public URL used in password-reset links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional email that is granted admin on signup
ADMIN_EMAIL=

# Optional OpenAI key for the assistant route
OPENAI_API_KEY=
